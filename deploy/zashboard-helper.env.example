# Copy to /etc/zashboard-helper/zashboard-helper.env and adjust every path.
# This file contains no Controller secret. Do not add one: Local Helper never needs it.

MIHOMO_CONFIG_PATH=/etc/mihomo/config.yaml
MIHOMO_BINARY=/usr/bin/mihomo
MIHOMO_RULES_DIR=/etc/mihomo/rules
MIHOMO_CUSTOM_RULES_DIR=/etc/mihomo/custom

# Secure default: reachable only from the same machine.
LOCAL_HELPER_HOST=127.0.0.1
LOCAL_HELPER_PORT=8787

# Comma-separated exact Origins, including scheme and port. Leave empty for same-origin proxying.
# Never use * on a network-accessible Helper.
LOCAL_HELPER_ALLOWED_ORIGINS=

LOCAL_HELPER_MAX_PROVIDER_BYTES=8388608
LOCAL_HELPER_MRS_TIMEOUT_MS=15000
LOCAL_HELPER_CONFIG_VALIDATION_TIMEOUT_MS=20000
LOCAL_HELPER_CUSTOM_RULES_BACKUPS=3
LOCAL_HELPER_MAX_REQUEST_BYTES=524288
